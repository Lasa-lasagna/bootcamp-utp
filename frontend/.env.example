# Copia este archivo como .env y rellena los valores del app registration

# App registration del SPA (tipo "single-page application") en Entra ID
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=

# App registration de la API (el backend, client id CLIENT_ID del backend)
VITE_API_CLIENT_ID=
# Si la API expone un scope concreto, indicalo; por defecto api://<VITE_API_CLIENT_ID>/.default
VITE_API_SCOPE=

# URL de la API
VITE_API_URL=http://localhost:1419
# Redirect URI registrada en Entra ID para el SPA (por defecto el origen actual)
VITE_REDIRECT_URI=http://localhost:5173
